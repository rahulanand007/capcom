CAPCOM_HTTP_ADDR=:8080
CAPCOM_HTTP_READ_HEADER_TIMEOUT=5s
CAPCOM_HTTP_SHUTDOWN_TIMEOUT=10s
CAPCOM_SERVICE_VERSION=dev
CAPCOM_LOG_LEVEL=info
CAPCOM_DEPLOYMENT_MODE=local
# Emergency local automation only. Leave unset for browser and hosted deployments.
# CAPCOM_ADMIN_TOKEN=
# Set true behind HTTPS in hosted deployments. Local HTTP development uses false.
CAPCOM_SECURE_COOKIES=false

# Base64-encoded 32-byte AES key. Generate a unique value before first run.
CAPCOM_SECRET_KEY=replace-with-base64-encoded-32-byte-key

# Compose uses these values. Keep the password URL-safe or percent-encode it in the URL.
CAPCOM_POSTGRES_USER=capcom
CAPCOM_POSTGRES_PASSWORD=replace-with-random-local-password
CAPCOM_POSTGRES_DB=capcom
# Used when running Go on the host. Compose constructs its own service URL.
CAPCOM_DATABASE_URL=postgres://capcom:replace-with-random-local-password@127.0.0.1:5432/capcom?sslmode=disable
CAPCOM_DATABASE_MAX_OPEN_CONNS=10
CAPCOM_DATABASE_MAX_IDLE_CONNS=5
CAPCOM_DATABASE_CONN_MAX_LIFETIME=30m
CAPCOM_SYNC_WORKER_ENABLED=true
CAPCOM_SYNC_WORKER_TICK=5s
CAPCOM_SYNC_MAX_CONCURRENCY=4
CAPCOM_SYNC_REQUEST_TIMEOUT=30s
CAPCOM_SYNC_MISSING_THRESHOLD=3
CAPCOM_TELEMETRY_WORKER_ENABLED=true
CAPCOM_TELEMETRY_WORKER_TICK=1m
CAPCOM_TELEMETRY_REQUEST_TIMEOUT=30s
# JSON array of provider/model context and USD-per-million-token pricing metadata.
CAPCOM_MODEL_CATALOG_JSON=
